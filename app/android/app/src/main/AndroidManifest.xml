<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 极光 JPush：AppKey / 渠道来自 build.gradle 的 manifestPlaceholders（CI 注入环境变量） -->
        <meta-data android:name="JPUSH_APPKEY" android:value="${JPUSH_APPKEY}" />
        <meta-data android:name="JPUSH_CHANNEL" android:value="${JPUSH_CHANNEL}" />

        <!-- Vivo 厂商通道密钥：vivo 推送 SDK 从这两个 meta-data 读取（极光 vivo 插件的
             manifestPlaceholders 不会自动注入，必须由开发者在本 Manifest 直接声明并覆盖空值）。
             缺失时 vivo 注册失败 → 杀后台收不到推送（只有极光自有通道能收，但需 App 进程存活）。 -->
        <meta-data
            android:name="com.vivo.push.api_key"
            android:value="d117ba583b770687b33fccc4b0a98192"
            tools:replace="android:value" />
        <meta-data
            android:name="com.vivo.push.app_id"
            android:value="106161110"
            tools:replace="android:value" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBar"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 极光推送通知被点击的接收器（记录消息类型并打开应用） -->
        <receiver
            android:name=".JPushReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="cn.jpush.android.intent.RECEIVE_MESSAGE" />
                <category android:name="${applicationId}" />
            </intent-filter>
        </receiver>

        <!-- JCore 2.0+ 必需：自定义 Service 继承 JCommonService，供 JCore 执行 init 等动作。
             缺失时 runActionWithService(action:init) 找不到 Service，SDK 静默卡死、设备永不注册。 -->
        <service
            android:name=".PushService"
            android:enabled="true"
            android:exported="false"
            android:process=":pushcore">
            <intent-filter>
                <action android:name="cn.jiguang.user.service.action" />
            </intent-filter>
        </service>
        <!-- 常驻保活（设置页「常驻保活」开关控制）：前台服务 + 低优先级常驻通知。
             必须跑在 :pushcore 进程——极光长连接（ConnectingHelper/TcpRequestManager）就在这个进程，
             进程被认定为前台服务后，vivo 划后台/一键清理不再杀它，长连接保持在线，
             杀后台也能秒收。不依赖厂商通道（未上架应用的 vivo 通道被「测试设备」限制，已确认走不通）。
             remoteMessaging 类型语义即"与服务器间收发远程消息"，需配套普通权限（安装时自动授予）。
             stopWithTask=false：任务被划掉时不连带停止服务（vivo 一键清理若只是移除任务而非
             强制停止，服务连带通知都能存活；强制停止场景由 KeepAliveReceiver 的闹钟复活兜底）。 -->
        <service
            android:name=".KeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:process=":pushcore"
            android:stopWithTask="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- 保活复活：KeepAliveService 挂的 10 分钟重复闹钟触发，被 ROM 杀掉后定期重启服务。
             必须静态注册（进程死后 context-register 的接收器收不到广播）。 -->
        <receiver
            android:name=".KeepAliveReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.loverspace.app.action.KEEPALIVE_RESURRECT" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 前台服务（常驻保活）：FOREGROUND_SERVICE_REMOTE_MESSAGING 为 Android 14+
         使用 remoteMessaging 类型 FGS 所需的普通权限，旧系统上自动忽略 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- 备份导出：仅 Android 9 及更早（API 24-28）写公共下载目录需要运行时申请；
         Android 10+ 走 MediaStore 免权限，此声明在新系统上自动忽略 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
</manifest>
